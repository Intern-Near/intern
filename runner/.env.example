# Copy to .env and fill in. .env is git-ignored. Never put a key in any other file, and never paste one into a log or chat.

# NEAR AI Cloud API key. Used for completions and for fetching their signatures.
NEARAI_API_KEY=

# The runner's NEAR testnet account (get_constants().runner). Its key is a function-call key limited to `propose`,
# `sign_next` and `report_result` on the coin contract (01 1.1: `sign_next` is runner-only, no deposit), so it
# cannot move money.
RUNNER_ACCOUNT_ID=
RUNNER_PRIVATE_KEY=

# A separate testnet account for `close`, which needs a 1-yocto deposit that a function-call key cannot attach, and
# `settle`. It holds only a little testnet NEAR and has no special rights in the contract.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=

# NEAR testnet RPC endpoint.
NEAR_RPC_URL=
