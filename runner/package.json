{
  "name": "intern-runner",
  "version": "0.0.0",
  "private": true,
  "description": "The off-chain Intern (Engine 2 of $INTERN): asks the AI, submits proposals, delivers signed orders.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env src/cli/check.ts",
    "record": "node --env-file-if-exists=.env src/cli/record-answers.ts",
    "verify-recordings": "node src/cli/verify-recordings.ts",
    "runner": "node --env-file-if-exists=.env src/cli/run.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.4.0"
  }
}
