{
  "name": "intern-runner",
  "version": "0.0.0",
  "private": true,
  "description": "The off-chain Intern (Engine 2 of $INTERN): asks the AI, submits proposals, delivers signed orders.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env src/cli/check.ts",
    "record": "node --env-file-if-exists=.env src/cli/record-answers.ts",
    "verify-recordings": "node src/cli/verify-recordings.ts",
    "verify-round": "node src/cli/verify-round.ts",
    "attestation-check": "node src/cli/attestation-check.ts",
    "runner": "node --env-file-if-exists=.env src/cli/run.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "npm run typecheck && npm run lint && npm test",
    "playbook-check": "node --env-file-if-exists=.env src/cli/playbook-check.ts",
    "fills-check": "node src/cli/fills-check.ts",
    "key-scope": "node src/cli/key-scope.ts",
    "books": "node src/cli/books-check.ts",
    "supply-log": "node src/cli/supply-log.ts",
    "quote": "node src/cli/quote.ts",
    "mcp": "node src/cli/mcp.ts",
    "mcp-check": "node src/cli/mcp-check.ts",
    "contract-scan": "node src/cli/contract-scan.ts",
    "refusals": "node src/cli/refusals.ts",
    "proof": "node src/cli/proof.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.4.0"
  }
}
